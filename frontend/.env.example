# DATUM frontend configuration
#
# Backend API URL consumed by the browser.
#   Unset or empty: API requests are relative to the frontend origin.
#                   In development the Vite dev server proxies /api to
#                   http://127.0.0.1:8000 (see frontend/vite.config.ts).
#   Remote backend / public tunnel: set this to the backend origin, e.g.
#                   VITE_API_BASE_URL=https://datum-backend.example.com
#
# This file is bundled into the frontend at build time. Do NOT put LLM API
# keys, database credentials, or other secrets here.
VITE_API_BASE_URL=
